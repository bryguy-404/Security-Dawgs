---
import Icon from './Icon.astro';
import {contactLink, navigation} from '../data/site';
---
<footer class="site-footer">
  <div class="container footer-main">
    <a href="/" class="footer-logo" aria-label="Security Dawgs home"><img src="/images/security-dawgs.webp" alt="Security Dawgs bulldog crest" width="1226" height="1283" loading="lazy" /></a>
    <p class="footer-tagline">Know your environment.<br/>Know your dependencies.<br/><span>Know your blast radius.</span></p>
    <nav class="footer-links" aria-label="Footer navigation">
      {navigation.map(link=><a href={link.href}>{link.label}<Icon name="diagonal" size={16}/></a>)}
      <a href={contactLink()} class="footer-contact">Show Me My Blast Radius <Icon name="diagonal" size={16}/></a>
    </nav>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Security Dawgs.</span><a href="#top">Back to top <span aria-hidden="true">↑</span></a></div>
</footer>
