---
interface Props {slug:string}
const {slug}=Astro.props;
---
<div class:list={['service-art',`art-${slug}`]} aria-hidden="true">
  {slug==='mdr' ? <div class="radar-art"><div class="radar-circle radar-outer"></div><div class="radar-circle radar-middle"></div><div class="radar-circle radar-inner"></div><div class="radar-cross horizontal"></div><div class="radar-cross vertical"></div><div class="radar-sweep"></div><span class="radar-dot dot-one"></span><span class="radar-dot dot-two"></span><div class="radar-label"><strong>24/7</strong></div></div> : slug==='compliance' ? <div class="compliance-art"><div class="audit-paper paper-back"><span>GDPR</span></div><div class="audit-paper paper-mid"><span>HIPAA</span></div><div class="audit-paper paper-front"><div class="paper-header"><span>SOC 2</span><span>✓</span></div><span class="paper-line long"></span><span class="paper-line short"></span><div class="paper-check"><span>✓</span><span>✓</span><span>✓</span></div><div class="paper-stamp">AUDIT<br/>READY.</div></div></div> : <div class="awareness-art"><div class="email-illustration"><div class="email-toolbar"><i></i><i></i><i></i></div><div class="envelope"><svg viewBox="0 0 200 140" fill="none"><path d="M10 10h180v120H10Z" stroke="currentColor" stroke-width="4"/><path d="m10 10 90 70 90-70M10 130l62-53m118 53-62-53" stroke="currentColor" stroke-width="4"/></svg></div></div><svg class="cursor-art" viewBox="0 0 80 100"><path d="m7 5 66 51-33 3-14 32Z" fill="var(--yellow)" stroke="var(--ink)" stroke-width="5"/></svg><span class="training-ring"></span></div>}
</div>
