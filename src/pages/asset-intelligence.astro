---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import DependencyPath from '../components/DependencyPath.astro';
import feedback from '../data/feedback.json';
import {contactLink} from '../data/site';
const a=feedback.asset;
const sentence=(value:string)=>value.charAt(0)+value.slice(1).toLowerCase().replace(/\bcmdb\b/g,'CMDB').replace(/\bot\b/g,'OT').replace(/^It /,'IT ');
const joined=(lines:string[],start=0,end=lines.length)=>lines.slice(start,end).join(' ');
const domains=Array.from({length:7},(_,i)=>({title:a.visibility.body[5+i*2],description:a.visibility.body[6+i*2]}));
const questionStarts=a.questions.body.flatMap((line,i)=>/^\d\. /.test(line)?[i]:[]);
const questions=questionStarts.map((start,i)=>({title:sentence(a.questions.body[start].replace(/^\d\. /,'')),body:a.questions.body.slice(start+1,questionStarts[i+1]??a.questions.body.length)}));
const pairs=(lines:string[])=>Array.from({length:lines.length/2},(_,i)=>({title:sentence(lines[i*2]),description:lines[i*2+1]}));
---
<Layout title="Asset Intelligence — Security Dawgs" description={a.hero.body[3]}>
  <section class="service-hero asset-hero">
    <div class="container service-hero-grid">
      <div class="service-hero-copy"><p class="page-name">Asset Intelligence</p><h1>Know your blast radius.<span class="yellow">Before something blows up.</span></h1><p class="hero-description">{a.hero.body[3]}</p><a href={contactLink()} class="button button-cream">Show Me My Blast Radius <Icon name="diagonal" size={21}/></a></div>
      <div class="asset-hero-diagram"><DependencyPath/></div>
    </div>
  </section>
  <section class="section-space asset-intro">
    <div class="container editorial-grid">
      <div data-reveal><p class="lead">{a.hero.body[0]}</p><h2 class="text-red">{a.hero.body[1]}</h2></div>
      <div class="prose" data-reveal><p>{a.hero.body[2]}</p><p class="statement">{a.hero.body[4]}<br/>{a.hero.body[5]}</p></div>
    </div>
  </section>
  <section class="section-space asset-visibility">
    <div class="container">
      <div class="editorial-grid" data-reveal><h2>{sentence(a.visibility.title)}</h2><div class="prose"><p>{joined(a.visibility.body,0,2)}</p><p>{joined(a.visibility.body,2,4)}</p></div></div>
      <p class="section-lead" data-reveal>{a.visibility.body[4]}</p>
      <div class="domain-grid">{domains.map(domain=><div data-reveal><h3>{domain.title}</h3><p>{domain.description}</p></div>)}</div>
      <p class="section-promise" data-reveal>{joined(a.visibility.body,19)}</p>
    </div>
  </section>
  <section class="section-space dependency-section">
    <div class="container editorial-grid">
      <div class="prose" data-reveal><h2>{sentence(a.dependencies.title)}</h2><p>{joined(a.dependencies.body,0,2)}</p><p>{a.dependencies.body[2]}</p><p>{a.dependencies.body[3]}</p><p class="inventory-label">{a.dependencies.body[4]}</p><p>{a.dependencies.body[5]}</p><div class="dependency-conversation"><p>{joined(a.dependencies.body,17,20)}</p><p>{a.dependencies.body[20]} <strong>{a.dependencies.body[21]}</strong></p></div></div>
      <div data-reveal><DependencyPath/></div>
    </div>
  </section>
  <section class="section-space blast-section dark-section">
    <div class="container">
      <h2 data-reveal>Know the blast radius.<br/><span class="yellow">Before the incident.</span></h2>
      <div class="scenario-list">{[1,3,5,7,9].map(i=><div data-reveal><p>{a.blast.body[i]}</p><h3>{a.blast.body[i+1]}</h3><Icon name="diagonal" size={30}/></div>)}</div>
      <div class="editorial-grid blast-close" data-reveal><div><h3>{a.blast.body[11]}</h3><p>{a.blast.body[12]}</p></div><div><p class="statement">{a.blast.body.slice(13,16).map(line=><span>{sentence(line)}</span>)}</p><a href={contactLink('Map My Blast Radius')} class="button button-cream">Map My Blast Radius <Icon name="diagonal" size={20}/></a></div></div>
    </div>
  </section>
  <section class="section-space">
    <div class="container reasons-grid">
      <h2 data-reveal>{sentence(a.questions.title)}</h2>
      <div class="reasons-list">{questions.map((question,i)=><details class="reason" open={i===0}><summary><h3>{question.title}</h3><span class="reason-toggle"><Icon name="cross" size={22}/></span></summary><div class="prose">{question.body.map(line=><p>{line}</p>)}</div></details>)}</div>
    </div>
  </section>
  <section class="section-space signals-section">
    <div class="container">
      <div class="editorial-grid" data-reveal><h2>{sentence(a.signals.title)}</h2><div class="prose"><p>{joined(a.signals.body,0,3)}</p><p>{joined(a.signals.body,3,9)}</p><p><strong>{a.signals.body[9]}</strong></p><p>{a.signals.body[10]}</p></div></div>
      <div class="signal-comparison" data-reveal><div><h3>{a.signals.body[11]}</h3>{a.signals.body.slice(12,16).map(line=><p>{line}</p>)}</div><div><h3>{a.signals.body[16]}</h3>{a.signals.body.slice(17).map(line=><p>{sentence(line)}</p>)}</div></div>
    </div>
  </section>
  <section class="section-space">
    <div class="container">
      <div class="editorial-grid" data-reveal><h2>{sentence(a.changes.title)}<br/><span class="text-red">{sentence(a.changes.body[0])}</span></h2><div class="prose">{a.changes.body.slice(10).map(line=><p>{line}</p>)}</div></div>
      <ul class="change-list" data-reveal>{a.changes.body.slice(1,10).map(line=><li><Icon name="arrow" size={18}/>{line}</li>)}</ul>
      <div class="integration-columns">
        <article class="prose" data-reveal><Icon name="eye" size={42}/><h2>{sentence(a.agentless.title)}</h2><h3>{sentence(a.agentless.body[0])}</h3>{a.agentless.body.slice(1,4).map(line=><p>{line}</p>)}<p class="statement">{joined(a.agentless.body,4)}</p></article>
        <article class="prose" data-reveal><Icon name="layers" size={42}/><h2>{sentence(a.tools.title)}</h2><h3>{sentence(a.tools.body[0])}</h3><p>{a.tools.body[1]}</p><ul class="tool-list">{a.tools.body.slice(2,10).map(line=><li>{line.replace(/\.$/,'')}</li>)}</ul><p>{joined(a.tools.body,10,12)}</p><p>{joined(a.tools.body,12,14)}</p><p class="statement">{joined(a.tools.body,14)}</p></article>
      </div>
    </div>
  </section>
  <section class="section-space planning-section">
    <div class="container editorial-grid">
      <div class="prose" data-reveal><h2>{sentence(a.planning.title)}</h2><p>{joined(a.planning.body,0,2)}</p><p>{a.planning.body[2]}</p><p class="statement">{a.planning.body[10]}</p></div>
      <ul class="check-list" data-reveal>{a.planning.body.slice(3,10).map(line=><li><Icon name="check" size={23}/>{line}</li>)}</ul>
    </div>
  </section>
  <section class="section-space business-section dark-section">
    <div class="container">
      <h2 data-reveal>{sentence(a.business.title)}</h2>
      <div class="business-examples">{[0,3,6].map(i=><article data-reveal><p>{a.business.body[i]}</p><p>{a.business.body[i+1]}</p><h3>{a.business.body[i+2]}</h3></article>)}</div>
      <div class="business-summary prose" data-reveal><p>{a.business.body[9]}</p><p>{joined(a.business.body,10,13)}</p><blockquote>{a.business.body[13]}</blockquote></div>
    </div>
  </section>
  <section class="section-space team-section">
    <div class="container"><h2 data-reveal>{sentence(a.teams.title)}</h2><div class="team-grid">{pairs(a.teams.body).map(team=><article data-reveal><h3>{team.title}</h3><p>{team.description}</p></article>)}</div></div>
  </section>
  <section class="section-space reveal-section">
    <div class="container editorial-grid"><div data-reveal><h2>{sentence(a.reveals.title)}</h2><p class="section-lead">Unknown assets. Cloud resources. OT. IoT. SaaS. Telecom circuits. Shadow IT. Dependencies. Internet-facing exposure. Owners. Blast radius.</p></div><div class="reveal-list">{pairs(a.reveals.body).map(item=><article data-reveal><Icon name="diagonal" size={22}/><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></div>
  </section>
  <section class="section-space incident-section">
    <div class="container"><h2 data-reveal>{sentence(a.incident.title)}</h2><div class="incident-comparison">
      <div class="incident-before"><h3>{a.incident.body[0]}</h3><ol>{a.incident.body.slice(1,18).filter(line=>line!=='↓').map(line=><li>{line}</li>)}</ol><p class="statement">{a.incident.body[18]}</p></div>
      <div class="incident-after"><h3>{sentence(a.response.title)}</h3><ol>{a.response.body.slice(0,13).filter(line=>line!=='↓').map(line=><li>{line}</li>)}</ol><p class="statement">{joined(a.response.body,13)}</p></div>
    </div></div>
  </section>
  <section class="section-space connected-assessment" id="connected-assessment">
    <div class="container editorial-grid">
      <div class="prose" data-reveal><h2>{sentence(a.assessment.title)}</h2><h3>{sentence(a.assessment.body[0])}</h3><p>{joined(a.assessment.body,1,3)}</p><p>{joined(a.assessment.body,11,13)}</p><a href={contactLink('Connected Asset Assessment')} class="button button-dark">Start My Connected Asset Assessment <Icon name="diagonal" size={21}/></a></div>
      <div data-reveal><h3>{a.assessment.body[3]}</h3><ul class="check-list">{a.assessment.body.slice(4,11).map(line=><li><Icon name="check" size={23}/>{line}</li>)}</ul></div>
    </div>
  </section>
  <section class="section-space asset-closing dark-section">
    <div class="container">
      <p class="closing-setup" data-reveal>{sentence(a.closing.title)}</p><h2 data-reveal>{sentence(a.closing.body[0])}</h2>
      <div class="editorial-grid" data-reveal><div><p>{a.closing.body[1]}</p><ul>{a.closing.body.slice(2,6).map(line=><li>{sentence(line)}</li>)}</ul></div><div class="prose"><p>{joined(a.closing.body,6,8)}</p><p class="statement yellow">{a.closing.body.slice(8,11).map(line=><span>{sentence(line)}</span>)}</p><p>{a.closing.body[11]}</p><a href={contactLink()} class="button button-cream">Show Me My Blast Radius <Icon name="diagonal" size={21}/></a></div></div>
    </div>
  </section>
</Layout>
