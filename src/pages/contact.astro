---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { companySizes, turnstileSiteKey } from '../data/form';
---
<Layout title="Contact Security Dawgs — Let's Talk Security" description="Tell Security Dawgs about your company. Start a conversation about asset intelligence, managed detection and response, compliance, or human risk.">
  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-copy">
        <p class="page-name">Contact Security Dawgs</p>
        <h1>Know what’s <br />at stake. <br /><span>Take the <br />next step.</span></h1>
        <p>Tell us a little about yourself and your company. We’ll be in touch to discuss what you need and how Security Dawgs can help.</p>
        <a href="/asset-intelligence/" class="text-link">Explore asset intelligence <Icon name="diagonal" size={18}/></a>
      </div>
      <div class="contact-card">
        <div id="form-heading"><h2>Let’s talk security.</h2><p>All five fields are required.</p></div>
        <form id="contact-form" action="/api/contact" method="post" data-sitekey={turnstileSiteKey} aria-labelledby="form-heading">
          <div class="form-fields">
            <div class="form-field full-field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div>
            <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
            <div class="form-field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="40" /></div>
            <div class="form-field full-field"><label for="company">Company name</label><input id="company" name="company" autocomplete="organization" required maxlength="160" /></div>
            <div class="form-field full-field"><label for="companySize">Company size <span>(number of employees)</span></label><select id="companySize" name="companySize" required><option value="" disabled selected>Select company size</option>{companySizes.map(size=><option value={size}>{size} employees</option>)}</select></div>
          </div>
          <div class="form-trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div id="turnstile-widget" class="turnstile-widget"></div>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          <button class="button button-dark form-submit" type="submit" disabled><span>Send my request</span><Icon name="diagonal" size={20}/></button>
          <p class="form-note">We’ll use these details to respond to your request.</p>
          <noscript><p class="form-status">Please enable JavaScript to load the spam protection and send your request.</p></noscript>
        </form>
        <div id="form-success" class="form-success" tabindex="-1" hidden>
          <div class="success-mark" aria-hidden="true">✓</div><h2>Request received.</h2><p>Thanks for reaching out. The Security Dawgs team will be in touch using the details you provided.</p><a class="text-link" href="/">Back to the website <Icon name="diagonal" size={18}/></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
<script>
  import '../scripts/contact';
</script>
<style>
  .contact-section{background:var(--red);padding-block:72px 88px;color:var(--cream)}
  .contact-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:70px;align-items:start}
  .contact-copy{padding-top:14px}.contact-copy h1{font-size:clamp(58px,5.7vw,86px);line-height:1.02;letter-spacing:-.065em}.contact-copy h1 span{color:var(--yellow)}
  .contact-copy>p:not(.page-name){max-width:440px;margin-top:30px;font-size:18px;color:#f5f3ede8}.contact-copy .text-link{margin-top:30px}.contact-copy .text-link:hover{color:var(--yellow)}
  .contact-card{background:var(--cream);color:var(--ink);padding:42px;box-shadow:12px 12px 0 #8f0924;min-width:0}.contact-card h2{font-size:36px;letter-spacing:-.045em}.contact-card #form-heading>p{color:var(--muted);font-size:14px;margin-top:10px}
  .form-fields{display:grid;grid-template-columns:1fr 1fr;gap:23px 18px;margin-top:28px}.full-field{grid-column:1/-1}.form-field{min-width:0}.form-field label{display:block;font-size:14px;font-weight:700;line-height:1.5;margin-bottom:8px}.form-field label span{font-weight:400;color:var(--muted)}
  .form-field input,.form-field select{width:100%;min-height:50px;border:1px solid #a5aaa1;background:#fff;color:var(--ink);padding:12px 13px;border-radius:0;font:inherit;font-size:16px}.form-field input:hover,.form-field select:hover{border-color:var(--ink)}.form-field input:focus-visible,.form-field select:focus-visible{outline-offset:2px}.form-field select{padding-right:28px}
  .form-trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.turnstile-widget{margin-top:25px;min-height:65px;max-width:100%}.form-submit{width:100%;border:0;justify-content:space-between;margin-top:16px}.form-submit:disabled{cursor:wait;opacity:.65}.form-note{font-size:12px;line-height:1.6;color:var(--muted);margin-top:14px}.form-status{font-size:14px;line-height:1.5;color:var(--red-dark);margin-top:12px}.form-status:empty{display:none}
  .form-success{padding-block:60px}.form-success[hidden]{display:none}.form-success p{margin-top:20px;color:var(--muted)}.form-success .text-link{margin-top:25px}.success-mark{display:grid;place-items:center;background:var(--yellow);width:62px;height:62px;font-size:34px;margin-bottom:26px}
  @media(max-width:1100px){.contact-grid{gap:40px}.contact-card{padding:30px}.form-field{grid-column:1/-1}}
  @media(max-width:800px){.contact-section{padding-block:48px 64px}.contact-grid{grid-template-columns:1fr;gap:40px}.contact-copy h1{font-size:clamp(52px,9vw,76px)}.contact-copy h1 br{display:none}.contact-copy h1 span{display:block}.contact-copy>p:not(.page-name){max-width:600px}.contact-card{padding:30px;box-shadow:7px 7px 0 #8f0924}}
  @media(max-width:420px){.contact-card{padding:23px 18px}.contact-card h2{font-size:30px}.contact-copy h1{font-size:48px}}
</style>
