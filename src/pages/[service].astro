---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceArt from '../components/ServiceArt.astro';
import CtaBand from '../components/CtaBand.astro';
import content from '../data/content.json';
import {contactLink,serviceInterests,navigation} from '../data/site';
export function getStaticPaths(){return content.services.map(service=>({params:{service:service.slug},props:{service}}));}
const {service}=Astro.props;
const interest=serviceInterests[service.slug as keyof typeof serviceInterests];
const headingLines:Record<string,string[]>={mdr:['Managed','Detection','& Response'],compliance:['Compliance','Advisory'],'awareness-training':['Human','Risk']};
const icons=['target','shield','eye'];
---
<Layout title={`${service.title} — Security Dawgs`} description={service.intro}>
  <section class:list={['service-hero',`service-hero-${service.slug}`]}>
    <div class="container service-hero-grid"><div class="service-hero-copy"><h1 aria-label={service.title}>{headingLines[service.slug].map((line,i)=><span class:list={{yellow:i===headingLines[service.slug].length-1}}>{line}{i < headingLines[service.slug].length-1 ? ' ' : ''}</span>)}</h1><p class="hero-description">{service.intro}</p><a href={contactLink(interest)} class="button button-cream">{service.cta.label}<Icon name="diagonal" size={20}/></a></div><ServiceArt slug={service.slug}/></div>
  </section>
  <section class="problem-section section-space"><div class="container editorial-grid" data-reveal><h2>{service.problemTitle}</h2><p class="section-intro">{service.problemDescription}</p></div></section>
  <section class="pillars-section section-space dark-section"><div class="container"><div class="pillar-grid">{service.pillars.map((pillar,i)=><article class="pillar" data-reveal data-delay={i*85}><Icon name={icons[i]} size={36}/><h2>{pillar.title}</h2><p>{pillar.description}</p></article>)}</div></div></section>
  <section class="reasons-section section-space"><div class="container reasons-grid"><h2 data-reveal>{service.reasonsTitle}</h2><div class="reasons-list">{service.reasons.map((reason,i)=><details class="reason" open={i===0}><summary><h3>{reason.title}</h3><span class="reason-toggle"><Icon name="cross" size={21}/></span></summary><p>{reason.description}</p></details>)}</div></div></section>
  <CtaBand {...service.cta} interest={interest}/>
  <section class="other-services"><div class="container"><h2>Explore services</h2><div class="other-service-links">{navigation.filter(s=>s.href!==`/${service.slug}/`&&s.href!=='/industries/').map(s=><a href={s.href}><span>{s.label}</span><Icon name="diagonal" size={25}/></a>)}</div></div></section>
</Layout>
